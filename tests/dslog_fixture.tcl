# dslog_fixture.tcl
#
#   Builds the small .ess file that tests/test_dslog_tables.tcl reads.  It
#   is a separate file so the same records can be regenerated by hand when
#   a golden transcript in the test has to be refreshed:
#
#       dlsh -e 'source tests/dslog_fixture.tcl; dslog_fixture_write /tmp/f.ess'
#
#   Every record is listed once, in file order, as
#       {varname timestamp type data}
#   with data already packed the way dserv logs it (native byte order).
#   dserv type codes: STRING 1, FLOAT 2, DOUBLE 3, SHORT 4, INT 5, EVT 9,
#   JSON 11, INT64 16.  An event record's type word is
#       EVT | type<<8 | subtype<<16 | puttype<<24
#   and dslog::read shows it as evt:type:subtype.

set ::dslog_fixture_t0 1761436800000000   ;# 2026-10-26 00:00:00 UTC, in us

proc dslog_fixture_evt {type subtype puttype} {
    expr {9 | ($type << 8) | ($subtype << 16) | ($puttype << 24)}
}

proc dslog_fixture_records {} {
    set T $::dslog_fixture_t0
    set recs {}
    # name ts type data
    lappend recs [list eventlog/events $T [dslog_fixture_evt 3 1 5] [binary format n 42]]
    lappend recs [list ess/status [expr {$T+1000}] 1 running]
    lappend recs [list eyetracking/raw [expr {$T+2000}] 2 [binary format f* {1.5 -2.0 3.25 4.0}]]
    lappend recs [list stim/frame [expr {$T+3000}] 16 \
                      [binary format m* [list 1 100 [expr {$T+2950}] 5000 0 1 2]]]
    lappend recs [list stim/cmd [expr {$T+3400}] 11 \
        "{\"seq\":1,\"cmd\":\"setBackground 0\",\"t_send\":[expr {$T+3100}],\"t_ret\":[expr {$T+3400}],\"dq\":0.5,\"done\":1,\"swap\":100,\"flip\":[expr {$T+3300}],\"status\":\"ok\"}"]
    lappend recs [list stim/frame [expr {$T+19700}] 16 \
                      [binary format m* [list 2 101 [expr {$T+19600}] 5100 0 0 0]]]
    lappend recs [list stim/cmd [expr {$T+20000}] 11 \
        "{\"seq\":2,\"cmd\":\"!show 1\",\"t_send\":[expr {$T+19800}],\"t_ret\":[expr {$T+20000}],\"dq\":null,\"done\":null,\"swap\":null,\"flip\":null,\"status\":\"nohdr\"}"]
    lappend recs [list stim/cmd [expr {$T+36000}] 11 \
        "{\"seq\":3,\"hash\":\"abc123\",\"len\":5000,\"t_send\":[expr {$T+35000}],\"t_ret\":[expr {$T+36000}],\"dq\":2,\"done\":3.5,\"swap\":102,\"flip\":[expr {$T+35900}],\"status\":\"ok\"}"]
    lappend recs [list stim/frame [expr {$T+36400}] 16 \
                      [binary format m* [list 3 102 [expr {$T+36300}] 5200 1 2 1]]]
    # two records with different key sets; z is null in both; nested/arr skipped
    lappend recs [list misc/json [expr {$T+40000}] 11 {{"a":1,"b":"x","z":null}}]
    lappend recs [list misc/json [expr {$T+41000}] 11 \
                      {{"b":"y","c":true,"z":null,"nested":{"k":1},"arr":[1,2]}}]
    # a string datapoint holding a JSON object
    lappend recs [list str/json [expr {$T+42000}] 1 "{\"v\":2.5}\x00"]
    # error cases
    lappend recs [list bad/json [expr {$T+43000}] 11 {{"ok":1}}]
    lappend recs [list bad/json [expr {$T+44000}] 11 {{not json}}]
    lappend recs [list mixed/json [expr {$T+45000}] 11 {{"k":1}}]
    lappend recs [list mixed/json [expr {$T+46000}] 11 {{"k":"s"}}]
    lappend recs [list short/frame [expr {$T+47000}] 16 [binary format m* {1 2 3 4 5 6 7}]]
    lappend recs [list short/frame [expr {$T+48000}] 16 [binary format m* {1 2 3 4 5}]]
    # other fixed-width payload types for unpack
    lappend recs [list dbl/arr [expr {$T+49000}] 3 [binary format d* {1.5 2.5}]]
    lappend recs [list sh/arr [expr {$T+50000}] 4 [binary format t* {1 -2 3}]]
    lappend recs [list int/arr [expr {$T+51000}] 5 [binary format n* {7 -8}]]
    # a JSON array is not a table row; a payload type that changes mid-file
    lappend recs [list arr/json [expr {$T+52000}] 11 {[1,2]}]
    lappend recs [list mix/arr [expr {$T+53000}] 16 [binary format m* {1 2}]]
    lappend recs [list mix/arr [expr {$T+54000}] 3 [binary format d* {1.0 2.0}]]
    return $recs
}

proc dslog_fixture_write {path} {
    set h [dslog::open $path w $::dslog_fixture_t0]
    foreach rec [dslog_fixture_records] {
        lassign $rec name ts type data
        dslog::put $h [dict create varname $name timestamp $ts flags 0 \
                           type $type data $data]
    }
    dslog::close $h
    return $path
}
